# Kevi — salin menjadi .env. Semua baris boleh dihapus; nilai di bawah adalah bawaan.
KEVI_PORT=8800
KEVI_BIND=0.0.0.0
# 1 jam kebun = 3600 / KEVI_LAJU detik. 60 = cepat (untuk mencoba); 6 sampai 12 untuk pemakaian harian.
KEVI_LAJU=60
KEVI_KOIN_AWAL=300
# Wajib 1 bila Kevi disajikan lewat HTTPS (misalnya di balik NPM).
KEVI_COOKIE_SECURE=0
# 0 mematikan terminal dalam game.
KEVI_TERMINAL=1
KEVI_TERMINAL_PER_MENIT=10
KEVI_TERMINAL_SERENTAK=4
